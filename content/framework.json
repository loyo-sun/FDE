{
  "version": 2,
  "title": "FDE 交付能力全景",
  "description": "六个交付阶段 × 七个能力领域，以工作、依赖和证据组织知识。",
  "phases": [
    {
      "id": "discover",
      "title": "发现与立项",
      "intent": "确认值得解决的问题",
      "gate": "问题、范围、数据权限与投入上限获得共识"
    },
    {
      "id": "design",
      "title": "方案与计划",
      "intent": "把约束变成可执行方案",
      "gate": "架构、契约、评测与风险控制可以被验证"
    },
    {
      "id": "build",
      "title": "构建与验证",
      "intent": "实现最小完整业务链路",
      "gate": "实现、数据、质量与权限通过预定验证"
    },
    {
      "id": "launch",
      "title": "上线与采用",
      "intent": "在受控范围证明可用",
      "gate": "灰度、培训、验收与运行责任准备齐全"
    },
    {
      "id": "operate",
      "title": "运行与改进",
      "intent": "持续兑现质量和业务价值",
      "gate": "服务、成本、知识与用户效果持续被核对"
    },
    {
      "id": "evolve",
      "title": "复用与演进",
      "intent": "把项目变成长期能力",
      "gate": "产品反馈、复用边界或退出安排明确"
    }
  ],
